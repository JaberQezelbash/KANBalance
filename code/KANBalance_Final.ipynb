
    "###############################################################################\n",
    "#           Further-Enhanced KAN Implementation with Learnable Knots\n",
    "#\n",
    "#  In this version, we introduce additional enhancements specifically for the\n",
    "#  KAN (Kolmogorov-Arnold Network) components, keeping other aspects similar\n",
    "#  to the previous code. Key improvements:\n",
    "#\n",
    "#   1. Per-Edge B-Spline Activations with Learnable Knots:\n",
    "#      - Instead of a single B-spline for each output dimension, we assign a\n",
    "#        B-spline activation for each (input_dim -> output_dim) edge. This\n",
    "#        provides more expressive power but increases model complexity.\n",
    "#      - We allow the knot vectors themselves to be partially learnable (one\n",
    "#        offset parameter per knot) for dynamic adaptation to data.\n",
    "#\n",
    "#   2. Dimension-Wise Regularization:\n",
    "#      - We can include an optional regularization term (e.g., L1 or L2) on\n",
    "#        the B-spline coefficients or on the knot offsets to avoid overfitting.\n",
    "#        For simplicity, we demonstrate how to add a small L2 regularization\n",
    "#        on the B-spline parameters.\n",
    "#\n",
    "#   3. Additional Skip Connection in KAN:\n",
    "#      - Each KANLayer can optionally mix a skip path from input to output\n",
    "#        before applying the final transformations, which can sometimes\n",
    "#        stabilize training and help gradient flow.\n",
    "#\n",
    "#  Other aspects (dataset split, Focal Loss, etc.) remain largely the same as\n",
    "#  our advanced code sample, except for the changed KAN architecture.\n",
    "#\n",
    "###############################################################################\n",
    "\n",
    "import os\n",
    "import random\n",
    "import numpy as np\n",
    "from glob import glob\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "from torch.utils.data import DataLoader, Dataset, random_split\n",
    "from torchvision import transforms\n",
    "from PIL import Image\n",
    "\n",
    "from sklearn.metrics import classification_report, confusion_matrix\n",
    "\n",
    "# Set random seeds for reproducibility\n",
    "SEED = 42\n",
    "random.seed(SEED)\n",
    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)\n",
    "if torch.cuda.is_available():\n",
    "    torch.cuda.manual_seed(SEED)\n",
    "\n",
    "# ==========================================\n",
    "#            1. Configuration\n",
    "# ==========================================\n",
    "DATA_DIR = r\"C:\\Users\\Jaber\\OneDrive - University of Florida\\Educational\\GitHub\\Datasets\\ImageClassification\\chest_xray\"\n",
    "\n",
    "BATCH_SIZE = 64\n",
    "NUM_EPOCHS = 50\n",
    "EARLY_STOPPING_PATIENCE = 3\n",
    "IMG_SIZE = 224\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "# ==========================================\n",
    "#          2. Dataset Preparation\n",
    "# ==========================================\n",
    "class ChestXRayDataset(Dataset):\n",
    "    \"\"\"\n",
    "    Custom Dataset to load Chest X-Ray images from 'NORMAL' and 'PNEUMONIA' folders.\n",
    "    \"\"\"\n",
    "    def __init__(self, file_paths, transform=None):\n",
    "        self.file_paths = file_paths\n",
    "        self.transform = transform\n",
    "        \n",
    "        self.labels = []\n",
    "        for fp in self.file_paths:\n",
    "            if \"NORMAL\" in fp:\n",
    "                self.labels.append(0)\n",
    "            else:\n",
    "                self.labels.append(1)\n",
    "                \n",
    "    def __len__(self):\n",
    "        return len(self.file_paths)\n",
    "    \n",
    "    def __getitem__(self, idx):\n",
    "        img_path = self.file_paths[idx]\n",
    "        label = self.labels[idx]\n",
    "        image = Image.open(img_path).convert(\"RGB\")\n",
    "        if self.transform is not None:\n",
    "            image = self.transform(image)\n",
    "        return image, torch.tensor(label, dtype=torch.long)\n",
    "\n",
    "# Gather all image paths\n",
    "normal_images = glob(os.path.join(DATA_DIR, \"NORMAL\", \"*.jpeg\")) + \\\n",
    "                glob(os.path.join(DATA_DIR, \"NORMAL\", \"*.jpg\")) + \\\n",
    "                glob(os.path.join(DATA_DIR, \"NORMAL\", \"*.png\"))\n",
    "\n",
    "pneumonia_images = glob(os.path.join(DATA_DIR, \"PNEUMONIA\", \"*.jpeg\")) + \\\n",
    "                   glob(os.path.join(DATA_DIR, \"PNEUMONIA\", \"*.jpg\")) + \\\n",
    "                   glob(os.path.join(DATA_DIR, \"PNEUMONIA\", \"*.png\"))\n",
    "\n",
    "all_files = normal_images + pneumonia_images\n",
    "random.shuffle(all_files)\n",
    "\n",
    "# Transforms\n",
    "transform = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize([0.485, 0.456, 0.406],[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "full_dataset = ChestXRayDataset(all_files, transform=transform)\n",
    "\n",
    "# Split 70/10/20\n",
    "total_len = len(full_dataset)\n",
    "train_len = int(0.7 * total_len)\n",
    "val_len   = int(0.1 * total_len)\n",
    "test_len  = total_len - train_len - val_len\n",
    "\n",
    "train_ds, val_ds, test_ds = random_split(\n",
    "    full_dataset, [train_len, val_len, test_len],\n",
    "    generator=torch.Generator().manual_seed(SEED)\n",
    ")\n",
    "\n",
    "train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True, drop_last=False)\n",
    "val_loader   = DataLoader(val_ds,   batch_size=BATCH_SIZE, shuffle=False, drop_last=False)\n",
    "test_loader  = DataLoader(test_ds,  batch_size=BATCH_SIZE, shuffle=False, drop_last=False)\n",
    "\n",
    "# ==========================================\n",
    "#  3. Advanced B-Spline with Learnable Knots\n",
    "# ==========================================\n",
    "def bspline_basis_vectorized(x, i, k, knots):\n",
    "    \"\"\"\n",
    "    Vectorized De Boor's recursion for B-spline base function, B_i,k(x).\n",
    "    Args:\n",
    "      x:     (Tensor) shape [N].\n",
    "      i:     (int) Index of the B-spline segment.\n",
    "      k:     (int) Polynomial order (k=3 => cubic).\n",
    "      knots: (Tensor) shape [num_knots].\n",
    "    Returns:\n",
    "      (Tensor) shape [N], values of the i-th B-spline basis of order k at x.\n",
    "    \"\"\"\n",
    "    if k == 0:\n",
    "        cond = (x >= knots[i]) & (x < knots[i+1])\n",
    "        return cond.float()\n",
    "    else:\n",
    "        denom1 = knots[i+k] - knots[i]\n",
    "        denom2 = knots[i+k+1] - knots[i+1]\n",
    "        \n",
    "        term1 = 0\n",
    "        term2 = 0\n",
    "        if denom1 > 0:\n",
    "            term1 = (x - knots[i]) / (denom1 + 1e-12) * bspline_basis_vectorized(x, i, k-1, knots)\n",
    "        if denom2 > 0:\n",
    "            term2 = (knots[i+k+1] - x) / (denom2 + 1e-12) * bspline_basis_vectorized(x, i+1, k-1, knots)\n",
    "        return term1 + term2\n",
    "\n",
    "\n",
    "class EdgeBSplineActivation(nn.Module):\n",
    "    \"\"\"\n",
    "    One advanced B-spline activation function per single \"edge\" (input_dim -> output_dim).\n",
    "    We also introduce partially learnable knots:\n",
    "      - We define a base knot vector, and each knot gets an offset parameter.\n",
    "    \"\"\"\n",
    "    def __init__(self, spline_order=3, num_basis=8, base_range=(-2, 2), learn_knots=True):\n",
    "        super().__init__()\n",
    "        self.spline_order = spline_order\n",
    "        self.num_basis = num_basis\n",
    "        self.num_knots = num_basis + spline_order + 1\n",
    "        \n",
    "        # Base knot vector (uniform)\n",
    "        base_knots = torch.linspace(base_range[0], base_range[1], self.num_knots)\n",
    "        self.register_buffer('base_knots', base_knots)\n",
    "        \n",
    "        # Offsets for each knot if we want them learnable\n",
    "        if learn_knots:\n",
    "            self.knot_offsets = nn.Parameter(torch.zeros(self.num_knots))\n",
    "        else:\n",
    "            self.knot_offsets = None\n",
    "        \n",
    "        # Coefficients (control points)\n",
    "        self.coeffs = nn.Parameter(torch.randn(self.num_basis) * 0.1)\n",
    "    \n",
    "    def forward(self, x):\n",
    "        # Flatten\n",
    "        orig_shape = x.shape\n",
    "        x_flat = x.view(-1)\n",
    "        \n",
    "        if self.knot_offsets is not None:\n",
    "            knots = self.base_knots + self.knot_offsets\n",
    "            # Ensure knots remain sorted (sort + small trick or clamp)\n",
    "            knots, _ = torch.sort(knots)\n",
    "        else:\n",
    "            knots = self.base_knots\n",
    "        \n",
    "        out = torch.zeros_like(x_flat, device=x.device, dtype=torch.float)\n",
    "        for i in range(self.num_basis):\n",
    "            b_i = bspline_basis_vectorized(x_flat, i, self.spline_order, knots)\n",
    "            out += self.coeffs[i] * b_i\n",
    "        \n",
    "        out = out.view(orig_shape)\n",
    "        return out\n",
    "\n",
    "# ==========================================\n",
    "#    4. Enhanced KAN Layer (Per-Edge)\n",
    "# ==========================================\n",
    "class EnhancedKANLayer(nn.Module):\n",
    "    \"\"\"\n",
    "    This KAN layer uses a separate B-spline activation for each edge.\n",
    "    That means if in_features=M and out_features=N, we have M*N\n",
    "    advanced B-spline activations. This provides very high flexibility.\n",
    "    We also add a skip connection from input to output (optional).\n",
    "    \"\"\"\n",
    "    def __init__(self, in_features, out_features, spline_order=3, num_basis=8,\n",
    "                 use_skip=True, learn_knots=True):\n",
    "        super().__init__()\n",
    "        self.in_features = in_features\n",
    "        self.out_features = out_features\n",
    "        self.use_skip = use_skip\n",
    "        \n",
    "        # Linear transform\n",
    "        self.linear = nn.Linear(in_features, out_features, bias=True)\n",
    "        \n",
    "        # One B-spline per edge: shape [out_features, in_features]\n",
    "        self.edge_activations = nn.ModuleList([\n",
    "            EdgeBSplineActivation(spline_order=spline_order, num_basis=num_basis,\n",
    "                                  learn_knots=learn_knots)\n",
    "            for _ in range(in_features * out_features)\n",
    "        ])\n",
    "    \n",
    "    def forward(self, x):\n",
    "        # x shape: [batch, in_features]\n",
    "        # We'll compute the linear transformation first, but instead of directly\n",
    "        # using linear_out, we apply the per-edge B-spline to each x_j * weight_ij.\n",
    "        \n",
    "        weight = self.linear.weight  # shape: [out_features, in_features]\n",
    "        bias   = self.linear.bias    # shape: [out_features]\n",
    "        \n",
    "        # We'll build the output by summing the B-spline-transformed edges\n",
    "        # out_i = sum_j( B_ij( x_j * W[i,j] ) ) + bias[i]\n",
    "        \n",
    "        # Prepare an empty output\n",
    "        batch_size = x.size(0)\n",
    "        out = torch.zeros(batch_size, self.out_features, device=x.device)\n",
    "        \n",
    "        # Index for the correct B-spline in the list\n",
    "        edge_index = 0\n",
    "        \n",
    "        for i in range(self.out_features):\n",
    "            sum_i = torch.zeros(batch_size, device=x.device)\n",
    "            \n",
    "            for j in range(self.in_features):\n",
    "                # Compute the pre-activation for edge (j->i)\n",
    "                pre_act = x[:, j] * weight[i, j]\n",
    "                # Apply the B-spline\n",
    "                sum_i += self.edge_activations[edge_index](pre_act)\n",
    "                edge_index += 1\n",
    "            \n",
    "            # Add the bias\n",
    "            out[:, i] = sum_i + bias[i]\n",
    "        \n",
    "        # Optional skip connection\n",
    "        if self.use_skip and self.in_features == self.out_features:\n",
    "            # If we want a skip, we can add x (dimension match required)\n",
    "            out = out + x\n",
    "        \n",
    "        return out\n",
    "\n",
    "# ==========================================\n",
    "#         5. Enhanced KAN Model\n",
    "# ==========================================\n",
    "class EnhancedKANModel(nn.Module):\n",
    "    \"\"\"\n",
    "    A KAN model with our Enhanced KAN layers (per-edge B-splines).\n",
    "    We keep a small CNN for feature extraction, then use two KAN layers.\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=2, use_skip=True, learn_knots=True):\n",
    "        super().__init__()\n",
    "        \n",
    "        self.feature_extractor = nn.Sequential(\n",
    "            nn.Conv2d(3, 16, kernel_size=3, stride=2, padding=1),\n",
    "            nn.BatchNorm2d(16),\n",
    "            nn.ReLU(),\n",
    "            nn.MaxPool2d(2),\n",
    "            \n",
    "            nn.Conv2d(16, 32, kernel_size=3, stride=2, padding=1),\n",
    "            nn.BatchNorm2d(32),\n",
    "            nn.ReLU(),\n",
    "            nn.MaxPool2d(2),\n",
    "            \n",
    "            nn.Conv2d(32, 64, kernel_size=3, stride=2, padding=1),\n",
    "            nn.BatchNorm2d(64),\n",
    "            nn.ReLU(),\n",
    "            nn.AdaptiveAvgPool2d((1,1))  # [batch, 64, 1, 1]\n",
    "        )\n",
    "        \n",
    "        # Two Enhanced KAN Layers: 64->32, then 32->16\n",
    "        self.kan1 = EnhancedKANLayer(\n",
    "            in_features=64, out_features=32,\n",
    "            spline_order=3, num_basis=8,\n",
    "            use_skip=False, learn_knots=learn_knots\n",
    "        )\n",
    "        \n",
    "        self.kan2 = EnhancedKANLayer(\n",
    "            in_features=32, out_features=16,\n",
    "            spline_order=3, num_basis=8,\n",
    "            use_skip=True,  # skip here if you want\n",
    "            learn_knots=learn_knots\n",
    "        )\n",
    "        \n",
    "        # Final classification\n",
    "        self.fc = nn.Linear(16, num_classes)\n",
    "        \n",
    "    def forward(self, x):\n",
    "        feats = self.feature_extractor(x)\n",
    "        feats = feats.view(feats.size(0), -1)\n",
    "        \n",
    "        x = self.kan1(feats)\n",
    "        x = self.kan2(x)\n",
    "        \n",
    "        logits = self.fc(x)\n",
    "        return logits\n",
    "\n",
    "# ==========================================\n",
    "#          6. Focal Loss Setup\n",
    "# ==========================================\n",
    "class FocalLoss(nn.Module):\n",
    "    def __init__(self, alpha=None, gamma=2.0, reduction='mean'):\n",
    "        super().__init__()\n",
    "        self.alpha = alpha\n",
    "        self.gamma = gamma\n",
    "        self.reduction = reduction\n",
    "        self.ce = nn.CrossEntropyLoss(reduction='none')\n",
    "        \n",
    "    def forward(self, inputs, targets):\n",
    "        ce_loss = self.ce(inputs, targets)  # shape [batch]\n",
    "        pt = torch.exp(-ce_loss)\n",
    "        focal_loss = (1-pt)**self.gamma * ce_loss\n",
    "        \n",
    "        if self.alpha is not None:\n",
    "            alpha_t = self.alpha[targets]\n",
    "            focal_loss = alpha_t * focal_loss\n",
    "        \n",
    "        if self.reduction == 'mean':\n",
    "            return focal_loss.mean()\n",
    "        elif self.reduction == 'sum':\n",
    "            return focal_loss.sum()\n",
    "        else:\n",
    "            return focal_loss\n",
    "\n",
    "# ==========================================\n",
    "#     7. Instantiate Model, Loss, Optim\n",
    "# ==========================================\n",
    "num_normal = len(normal_images)\n",
    "num_pneu   = len(pneumonia_images)\n",
    "total      = num_normal + num_pneu\n",
    "\n",
    "alpha_normal = num_pneu / float(total)\n",
    "alpha_pneu   = num_normal / float(total)\n",
    "alpha_tensor = torch.FloatTensor([alpha_normal, alpha_pneu]).to(DEVICE)\n",
    "\n",
    "model = EnhancedKANModel(num_classes=2, use_skip=True, learn_knots=True).to(DEVICE)\n",
    "criterion = FocalLoss(alpha=alpha_tensor, gamma=2.0).to(DEVICE)\n",
    "\n",
    "# We can optionally add L2 regularization for the B-spline parameters\n",
    "# Let's separate out the B-spline parameters from others for custom weight decay\n",
    "b_spline_params = []\n",
    "other_params    = []\n",
    "for name, param in model.named_parameters():\n",
    "    if \"edge_activations\" in name or \"knot_offsets\" in name or \"coeffs\" in name:\n",
    "        b_spline_params.append(param)\n",
    "    else:\n",
    "        other_params.append(param)\n",
    "\n",
    "# Example: a smaller weight decay for B-spline params, larger for the rest\n",
    "optimizer = optim.Adam([\n",
    "    {'params': other_params, 'weight_decay': 1e-4},\n",
    "    {'params': b_spline_params, 'weight_decay': 1e-5}\n",
    "], lr=1e-4)\n",
    "\n",
    "# ==========================================\n",
    "#     8. Metric Utilities / Evaluation\n",
    "# ==========================================\n",
    "def calculate_metrics(outputs, targets):\n",
    "    _, preds = torch.max(outputs, 1)\n",
    "    correct = (preds == targets).sum().item()\n",
    "    total = targets.size(0)\n",
    "    accuracy = correct / total\n",
    "    return accuracy, preds, targets\n",
    "\n",
    "def evaluate_model(model, loader):\n",
    "    model.eval()\n",
    "    all_preds = []\n",
    "    all_targets = []\n",
    "    correct = 0\n",
    "    total = 0\n",
    "    with torch.no_grad():\n",
    "        for images, labels in loader:\n",
    "            images, labels = images.to(DEVICE), labels.to(DEVICE)\n",
    "            outputs = model(images)\n",
    "            _, preds = torch.max(outputs, 1)\n",
    "            correct += (preds == labels).sum().item()\n",
    "            total += labels.size(0)\n",
    "            all_preds.extend(preds.cpu().numpy())\n",
    "            all_targets.extend(labels.cpu().numpy())\n",
    "    accuracy = correct / total if total > 0 else 0\n",
    "    return accuracy, np.array(all_preds), np.array(all_targets)\n",
    "\n",
    "def print_confusion_matrix(y_true, y_pred, dataset_name=\"Validation\"):\n",
    "    print(f\"\\nConfusion Matrix ({dataset_name}):\")\n",
    "    print(confusion_matrix(y_true, y_pred))\n",
    "\n",
    "# ==========================================\n",
    "#        9. Training Loop w/ Early Stop\n",
    "# ==========================================\n",
    "best_val_acc = 0.0\n",
    "epochs_no_improve = 0\n",
    "early_stop = False\n",
    "\n",
    "best_model_state = None\n",
    "\n",
    "for epoch in range(NUM_EPOCHS):\n",
    "    if early_stop:\n",
    "        break\n",
    "    \n",
    "    model.train()\n",
    "    running_loss = 0.0\n",
    "    running_acc = 0.0\n",
    "    total_samples = 0\n",
    "    \n",
    "    print(f\"\\n=== Epoch {epoch+1}/{NUM_EPOCHS} ===\")\n",
    "    \n",
    "    for batch_idx, (images, labels) in enumerate(train_loader):\n",
    "        images, labels = images.to(DEVICE), labels.to(DEVICE)\n",
    "        \n",
    "        optimizer.zero_grad()\n",
    "        outputs = model(images)\n",
    "        loss = criterion(outputs, labels)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        \n",
    "        # Batch metrics\n",
    "        acc, _, _ = calculate_metrics(outputs, labels)\n",
    "        batch_size_current = labels.size(0)\n",
    "        running_loss += loss.item() * batch_size_current\n",
    "        running_acc  += acc * batch_size_current\n",
    "        total_samples += batch_size_current\n",
    "        \n",
    "        # Print batch-level metrics\n",
    "        print(f\"  [Batch {batch_idx+1:03d}] Loss: {loss.item():.4f}, Acc: {acc*100:.2f}%\")\n",
    "    \n",
    "    # End epoch metrics\n",
    "    epoch_train_loss = running_loss / total_samples\n",
    "    epoch_train_acc  = running_acc / total_samples\n",
    "    \n",
    "    # Validation\n",
    "    val_acc, val_preds, val_targets = evaluate_model(model, val_loader)\n",
    "    \n",
    "    print(f\"  -> Epoch Training Loss: {epoch_train_loss:.4f}, Training Accuracy: {epoch_train_acc*100:.2f}%\")\n",
    "    print(f\"  -> Validation Accuracy: {val_acc*100:.2f}%\")\n",
    "    \n",
    "    # Validation classification report\n",
    "    print(\"\\nValidation Classification Report:\")\n",
    "    print(classification_report(val_targets, val_preds, target_names=[\"NORMAL\", \"PNEUMONIA\"]))\n",
    "    \n",
    "    # Validation confusion matrix\n",
    "    print_confusion_matrix(val_targets, val_preds, dataset_name=\"Validation\")\n",
    "    \n",
    "    # Early stopping\n",
    "    if val_acc > best_val_acc:\n",
    "        best_val_acc = val_acc\n",
    "        epochs_no_improve = 0\n",
    "        best_model_state = model.state_dict()\n",
    "    else:\n",
    "        epochs_no_improve += 1\n",
    "        if epochs_no_improve >= EARLY_STOPPING_PATIENCE:\n",
    "            print(\"Early stopping triggered!\")\n",
    "            early_stop = True\n",
    "\n",
    "# ==========================================\n",
    "#          10. Test Evaluation\n",
    "# ==========================================\n",
    "if best_model_state is not None:\n",
    "    model.load_state_dict(best_model_state)\n",
    "\n",
    "test_acc, test_preds, test_targets = evaluate_model(model, test_loader)\n",
    "print(\"\\n=== Test Set Results ===\")\n",
    "print(f\"Test Accuracy: {test_acc*100:.2f}%\")\n",
    "\n",
    "print(\"Test Classification Report:\")\n",
    "print(classification_report(test_targets, test_preds, target_names=[\"NORMAL\", \"PNEUMONIA\"]))\n",
    "\n",
    "print_confusion_matrix(test_targets, test_preds, dataset_name=\"Test\")\n"
   ]
